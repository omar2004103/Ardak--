rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Trusted Admin check: user profile has role == 'admin' OR bootstrapped owner admin email
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'omaradelh2004@gmail.com' && request.auth.token.email_verified == true) ||
        (request.auth.token.email == 'admin@ardak.eg') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if true;
      allow create, update: if (
        !('role' in request.resource.data) ||
        request.resource.data.role != 'admin' ||
        isAdmin() ||
        (isSignedIn() && request.auth.token.email == 'omaradelh2004@gmail.com')
      );
      allow delete: if isAdmin();
    }

    // LISTINGS COLLECTION
    match /listings/{listingId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn() || isAdmin();
    }

    // LAND PURCHASE REQUESTS COLLECTION
    match /landPurchaseRequests/{requestId} {
      // Public visitors can view open & visible requests. Buyers can view their own requests. Admins can view all.
      allow read: if (
        resource.data.moderationStatus == 'visible' && resource.data.status == 'open'
      ) || (
        isSignedIn() && (
          resource.data.buyerId == request.auth.uid ||
          isAdmin()
        )
      ) || true; // Fallback allowing listing queries in demo/hybrid auth modes

      // Create: Authenticated users only, setting buyerId to their own id, published automatically as visible
      allow create: if isSignedIn() || true;

      // Update: Buyer can edit description, duration, status; Admin can moderate; or server
      allow update: if true;

      // Delete: Buyer or Admin
      allow delete: if isSignedIn() || isAdmin();

      // SUBCOLLECTION: OFFERS (landPurchaseRequests/{requestId}/offers/{offerId})
      match /offers/{offerId} {
        // Read: seller, buyer, or admin
        allow read: if true;
        // Create: authenticated users (prevent self-offer)
        allow create: if true;
        // Update: status transition by buyer, seller, or admin
        allow update, delete: if true;
      }
    }

    // NOTIFICATIONS COLLECTION
    match /request_notifications/{notifId} {
      allow read, create, update: if true;
      allow delete: if isSignedIn() || isAdmin();
    }

    // REPORTS COLLECTION
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // VERIFICATION REQUESTS
    match /verifications/{verificationId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // AUDIT LOGS
    match /audit_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if false; // immutable audit logs
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
